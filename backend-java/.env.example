# Server; hosted platforms provide PORT automatically.
PORT=8080

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/blood_connector
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-postgresql-password

# JWT: Base64-encode at least 32 cryptographically random bytes.
# Generate in PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET=replace-with-a-base64-encoded-random-key
JWT_EXPIRATION_MILLIS=86400000

# Explicit comma-separated frontend origins. Never use * with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173
